# Cabeçalhos aplicados pela Cloudflare aos assets estáticos.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML: sempre revalida, para que uma publicação nova apareça na hora
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS: versionados pelo hash do conteúdo (?v=<hash>), por
# tools/versionar-assets.py. Um dia de cache com revalidação.
# Os nomes aqui têm de ser os arquivos que as páginas realmente carregam:
# até 21/09/2026 esta lista ainda citava style.css e script.js, mortos desde a
# migração para sistema.css — e sistema.css, efeitos.js, cena.js e rastreio.js,
# que são os vivos, caíam no padrão do Cloudflare sem passar por aqui.
/sistema.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/legal.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/efeitos.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/cena.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/rastreio.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/consentimento.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Imagens e ícones: nomes estáveis, cache longo
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes: a versão está no nome do arquivo (softpay-*-v1.woff2); fonte nova
# ganha -v2, então o cache pode ser eterno.
/fontes/*
  Cache-Control: public, max-age=31536000, immutable

# Arquivos de SEO: cache curto, mudam junto com o conteúdo
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# llms.txt: resumo do produto para assistentes de IA. Precisa sair como
# text/plain e em UTF-8; sem o charset explicito o acento chega quebrado.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
